{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-assembler.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-assembler-fallback.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-trace-capture.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-state-nudge.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-session-summary.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-pre-compact.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-post-compact.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/emretuncbilek/harness-harness/.claude/hooks/hh-session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}